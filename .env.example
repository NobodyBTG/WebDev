# ── Part Bike Value — API keys (all optional) ────────────────────────────
# Copy this file to .env.local and fill in what you have.
# The app works fully WITHOUT any keys — it falls back to the built-in
# rule-based parser and smart eBay search links.

# AI parsing / report polish (either one; Anthropic is preferred if both set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# eBay Browse API (live active-listing counts). Get keys at developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
